APP_NAME="NITIP DI END"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00

# Production (Cloudflare / reverse proxy in front):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
SEED_BOOTSTRAP_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nitipdiend
DB_USERNAME=root
DB_PASSWORD=

# For local dev with SQLite, use:
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Web Push (VAPID). Generate with: php artisan webpush:vapid --write
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Browsershot (Puppeteer/Chrome PDF generator)
# ---------------------------------------------------------------------------
# On Windows, PHP exec() may not find node/npm automatically.
# Run `where.exe node` and `where.exe npm` to get the full paths.
# Run `node -e "const p=require('puppeteer');console.log(p.executablePath())"` for Chrome.
#
# BROWSERSHOT_NODE_PATH=C:\Program Files\nodejs\node.exe
# BROWSERSHOT_NPM_PATH=C:\Program Files\nodejs\npm.cmd
# BROWSERSHOT_CHROME_PATH=
# Path global node_modules untuk require('puppeteer'). Kosongkan kalau
# Puppeteer ada di node_modules project (lokal). Di server WAJIB diisi
# karena node_modules project tidak ikut ter-deploy.
# BROWSERSHOT_NODE_MODULE_PATH=
# BROWSERSHOT_CHROME_ARGS=
# On EC2/Linux production use:
# BROWSERSHOT_CHROME_ARGS=no-sandbox,disable-setuid-sandbox,disable-dev-shm-usage
