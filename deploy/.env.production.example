# Copy to deploy/.env.production (gitignored) and fill in, then deploy.ps1 uploads it as <app>/.env
APP_NAME="NITIP DI END"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jastip.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jastip
DB_USERNAME=jastip
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Browsershot / Chrome (WAJIB untuk invoice PDF) -------------------------
# Template invoice pakai flexbox; hanya Chrome headless yang bisa merendernya
# dengan benar. Tanpa ini invoice PDF jatuh ke DomPDF dan layout-nya rusak.
# Bootstrap (deploy/bootstrap.sh) memasang Node + Chrome dan membuat symlink
# stabil di /opt/chrome-stable, jadi path di bawah tidak ikut versi.
BROWSERSHOT_NODE_PATH=/usr/bin/node
BROWSERSHOT_NPM_PATH=/usr/bin/npm
BROWSERSHOT_CHROME_PATH=/opt/chrome-stable/chrome-linux64/chrome
# Puppeteer dipasang global karena node_modules project tidak ikut ter-deploy.
# Path global BERBEDA antar sumber paket:
#   - paket distro Ubuntu : /usr/lib/node_modules
#   - NodeSource / manual : /usr/local/lib/node_modules
# Kalau dikosongkan, path-nya dideteksi otomatis (cari folder yang berisi puppeteer).
# Cek path sebenarnya di server: npm root -g
BROWSERSHOT_NODE_MODULE_PATH=
BROWSERSHOT_CHROME_ARGS=no-sandbox,disable-setuid-sandbox,disable-dev-shm-usage
